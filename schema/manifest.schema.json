{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isokron-ai/mcp-results/schema/manifest.schema.json",
  "title": "data/manifest.json",
  "description": "What the dataset holds: every file with its digest and record count, the totals, and per lane the coverage by state and by fault side. The per-lane map is checked by scripts/verify.mjs (the schema checker does not read maps).",
  "type": "object",
  "required": ["schema", "licence", "note", "registry", "totals", "lanes", "files", "corrections", "prev_manifest_sha256"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "mcp-results/manifest/1" },
    "licence": { "const": "CC-BY-4.0" },
    "note": { "type": "string", "minLength": 1 },
    "registry": {
      "type": "object",
      "required": ["version", "sha256"],
      "additionalProperties": false,
      "properties": { "version": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "totals": {
      "type": "object",
      "required": ["records", "subjects", "files", "corrections"],
      "additionalProperties": false,
      "properties": {
        "records": { "type": "integer", "minimum": 0 },
        "subjects": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "corrections": { "type": "integer", "minimum": 0 }
      }
    },
    "lanes": { "type": "object" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "lane", "day", "records", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^results/[a-z0-9][a-z0-9-]{0,63}/\\d{4}-\\d{2}-\\d{2}\\.jsonl$" },
          "lane": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "records": { "type": "integer", "minimum": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "corrections": {
      "type": ["object", "null"],
      "required": ["path", "entries"],
      "additionalProperties": false,
      "properties": { "path": { "const": "corrections.jsonl" }, "entries": { "type": "integer", "minimum": 1 } }
    },
    "prev_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
