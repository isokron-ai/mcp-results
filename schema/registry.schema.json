{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isokron-ai/mcp-results/schema/registry.schema.json",
  "title": "Field registry (fields/registry.yaml)",
  "type": "object",
  "required": ["version", "fields"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 0 },
    "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["id", "layer", "type", "unit", "source", "class", "redaction", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "layer": {
          "enum": [
            "identity_discovery", "protocol", "derived_semantics", "source_build",
            "repo_ecosystem", "runtime", "tool_telemetry", "write_tests", "longitudinal"
          ]
        },
        "type": { "enum": ["string", "integer", "number", "boolean", "enum", "array", "object", "timestamp", "hash"] },
        "unit": { "enum": ["none", "ms", "bytes", "tokens", "count", "ratio", "percent", "lines", "chars", "days"] },
        "source": {
          "enum": [
            "discover", "meta-github", "meta-registry", "scan-static", "scan-live", "scan-deep",
            "build-probe", "writecheck", "ingest-compact", "loop-telemetry", "remote-meta", "release-diff", "meta-backend"
          ]
        },
        "class": { "enum": ["P", "P-s", "P-h", "P-t", "PA", "B", "S", "M", "X"] },
        "redaction": {
          "type": ["array", "null"],
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["R1", "R2", "R3", "R4"] }
        },
        "status": { "enum": ["planned", "active", "deprecated"] }
      }
    }
  }
}
